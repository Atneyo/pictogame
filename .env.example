# Copy this file to ".env" and set your own values.
# Use only letters, digits, "-", "_" and "." in values (no quotes, spaces, $, # or backslashes).
DB_NAME=pictogame
DB_USER=pictogame
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Port on your machine where MySQL is published
DB_PORT=3306
# Port on your machine where the app is exposed
APP_PORT=3000